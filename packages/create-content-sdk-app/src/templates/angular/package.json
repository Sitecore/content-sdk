{
  "name": "<%- appName %>",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "gen:env": "tsx scripts/generate-environment.ts",
    "gen:env:dev": "tsx scripts/generate-environment.ts --dev",
    "gen:env:prod": "tsx scripts/generate-environment.ts --prod",
    "start": "run-s gen:env:dev start:app",
    "start:app": "ng serve",
    "build": "run-s gen:env:prod build:app",
    "build:app": "ng build",
    "watch": "run-s gen:env:dev watch:app",
    "watch:app": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr": "run-s build serve:ssr:app",
    "serve:ssr:app": "node dist/<%- appName %>/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  <%_ if (helper.isDev) { -%>
  "installConfig": {
    "hoistingLimits": "none"
  },
  <% } -%>
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.4",
    "@sitecore-content-sdk/angular": "^2.0.0-canary.6",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tailwind-bootstrap-grid": "^6.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^27.1.0",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.19.4",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
