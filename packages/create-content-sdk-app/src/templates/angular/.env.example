# Shared defaults. Loaded first by `npm run gen:env:dev` and `npm run gen:env:prod`.
# Copy to `.env` and fill in. Do not commit `.env`.

# Edge API
# SITECORE_EDGE_CONTEXT_ID=
# SITECORE_EDGE_CLIENT_CONTEXT_ID=
# SITECORE_EDGE_PLATFORM_HOSTNAME=
# SITECORE_EXPERIENCE_EDGE_HOSTNAME=

# Local API (non-Edge)
# SITECORE_API_KEY=
# SITECORE_API_HOST=

# Editing
# SITECORE_EDITING_SECRET=

# Site / language
# SITECORE_DEFAULT_SITE=
# SITECORE_DEFAULT_LANGUAGE=en

# Personalize
# SITECORE_PERSONALIZE_SCOPE=
# PERSONALIZE_MIDDLEWARE_EDGE_TIMEOUT=
# PERSONALIZE_MIDDLEWARE_CDP_TIMEOUT=

# CORS
# JSS_ALLOWED_ORIGINS=
