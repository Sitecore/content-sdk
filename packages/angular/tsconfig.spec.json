{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["jest", "node"],
    "declaration": false,
    "declarationMap": false,
    "emitDecoratorMetadata": true,
    "module": "CommonJS",
    "moduleResolution": "node"
  },
  "include": ["src/**/*.spec.ts", "src/**/*.ts", "test/**/*.ts"]
}
