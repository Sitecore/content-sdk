{
  "name": "@sitecore-content-sdk/angular",
  "version": "1.4.0-canary.12",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "build:watch": "ng-packagr -p ng-package.json --watch",
    "clean": "del-cli dist",
    "lint": "eslint \"./src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "author": {
    "name": "Sitecore Corporation",
    "url": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sitecore/content-sdk"
  },
  "license": "Apache-2.0",
  "homepage": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html",
  "bugs": {
    "url": "https://github.com/sitecore/content-sdk/issues"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "@sitecore-content-sdk/core": "1.4.0-canary.12",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vitest-angular": "^1.14.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@types/node": "^22.15.14",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "@vitest/coverage-v8": "^3.2.4",
    "del-cli": "^6.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "52.0.3",
    "eslint-plugin-prettier": "^4.0.0",
    "jsdom": "^26.1.0",
    "ng-packagr": "^21.0.0",
    "prettier": "^2.8.0",
    "rxjs": "^7.8.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4",
    "zone.js": "^0.15.0"
  },
  "sideEffects": false,
  "description": "Angular SDK for Sitecore Content SDK",
  "gitHead": "2f4820efddf4454eeee58ed1b2cc251969efdf5b",
  "exports": {
    "./package.json": {
      "default": "./dist/package.json"
    },
    ".": {
      "types": "./dist/types/sitecore-content-sdk-angular.d.ts",
      "default": "./dist/fesm2022/sitecore-content-sdk-angular.mjs"
    }
  }
}
