{
  "name": "@sitecore-content-sdk/__core__",
  "version": "0.1.0",
  "description": "> TODO: description",
  "author": {
    "name": "Sitecore Corporation",
    "url": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html"
  },
  "homepage": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html",
  "license": "Apache-2.0",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "files": [
    "dist",
    "types",
    "/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig-esm.json",
    "clean": "del-cli dist types",
    "lint": "eslint \"./src/**/*.ts\"",
    "test": "jest --config jest.config.ts",
    "prepublishOnly": "npm run build",
    "coverage": "jest --config jest.config.ts --coverage",
    "generate-docs": "npx typedoc --plugin typedoc-plugin-markdown --outputFileStrategy Members --parametersFormat table --readme none --out ../../ref-docs/react src/index.ts --githubPages false",
    "api-extractor": "npm run build && api-extractor run --local --verbose",
    "api-extractor:verify": "api-extractor run"
  },
  "bugs": {
    "url": "https://github.com/sitecore/content-sdk/issues"
  },
  "exports": {
    "./server": {
      "import": "./dist/esm/server.js",
      "require": "./dist/cjs/server.js",
      "types": "./types/client/index.d.ts"
    },
    "./browser": {
      "import": "./dist/esm/browser.js",
      "require": "./dist/cjs/browser.js",
      "types": "./types/browser/index.d.ts"
    },
    "./internal": {
      "import": "./dist/esm/internal.js",
      "require": "./dist/cjs/internal.js",
      "types": "./types/internal/index.d.ts"
    }
  },
  "devDependencies": {
    "@jest/types": "^30.2.0",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@types/debug": "^4.1.12",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "52.0.3",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^30.2.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@sitecore-content-sdk/utils": "0.1.0",
    "debug": "^4.4.3"
  }
}
