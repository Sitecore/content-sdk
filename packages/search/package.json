  },
  "license": "Apache-2.0",
  "homepage": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html",
  "bugs": {
    "url": "https://github.com/sitecore/content-sdk/issues"
  },
  "dependencies": {
    "@sitecore-content-sdk/core": "1.3.0-canary.35"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.4.1",
    "eslint-plugin-prettier": "^5.5.4",
    "mocha": "^11.7.5",
    "nock": "^14.0.10",
    "nyc": "^17.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3"
  },
  "description": "",
  "types": "types/index.d.ts",
