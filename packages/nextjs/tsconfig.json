{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "jsx": "react",
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["node", "mocha"],
    "typeRoots": ["node_modules/@types"],
    "declarationDir": "./types"
  },
  "exclude": [
    "node_modules",
    "types",
    "typings",
    "dist",
    "src/tests/*",
    "src/test-data/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "component-props-loader.d.ts"
  ]
}
