{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2015",
    "module": "CommonJS",
    "jsx": "react",
    "skipLibCheck": true,
    "outDir": "dist/cjs",
    "types": ["node"],
    "typeRoots": ["node_modules/@types"],
    "declarationDir": "./types",
    "paths": { "#scConfigProvider": ["./src/config-provider/config-provider.d.ts"] }
  },
  "exclude": [
    "node_modules",
    "types",
    "typings",
    "dist",
    "codegen.d.ts",
    "context.d.ts",
    "config.d.ts",
    "proxy.d.ts",
    "route-handler.d.ts",
    "editing.d.ts",
    "monitoring.d.ts",
    "middleware.d.ts",
    "component-props-loader.d.ts",
    "site.d.ts",
    "search.d.ts",
    "client.d.ts",
    "utils.d.ts",
    "tools.d.ts",
    "config-cli.d.ts",
    "src/tests/*",
    "src/test-data/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/tools/codegen/test-data/*",
    "api"
  ]
}
