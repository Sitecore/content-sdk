{
  "name": "@sitecore-content-sdk/core",
  "version": "2.1.0-canary.10",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig-esm.json",
    "clean": "del-cli dist types",
    "lint": "eslint \"./src/**/*.ts\"",
    "test": "mocha \"./src/**/*.test.ts\"",
    "prepublishOnly": "npm run build",
    "coverage": "nyc npm test",
    "generate-docs": "npx typedoc --plugin typedoc-plugin-markdown --outputFileStrategy Members --parametersFormat table --readme none --out ../../ref-docs/core --entryPoints src/index.ts --entryPoints src/tools/index.ts --entryPoints src/tools/index-node.ts --githubPages false",
    "api-extractor": "npm run build && api-extractor run --local --verbose",
    "api-extractor:verify": "api-extractor run"
  },
  "engines": {
    "node": ">=24"
  },
  "author": {
    "name": "Sitecore Corporation",
    "url": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sitecore/content-sdk"
  },
  "license": "Apache-2.0",
  "homepage": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html",
  "bugs": {
    "url": "https://github.com/sitecore/content-sdk/issues"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.2.2",
    "@types/chai": "^5.2.2",
    "@types/chai-spies": "^1.0.6",
    "@types/debug": "^4.1.12",
    "@types/memory-cache": "^0.2.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.4",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^17.0.4",
    "@types/url-parse": "1.4.11",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "chai": "^4.4.1",
    "chai-spies": "^1.1.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "52.0.3",
    "eslint-plugin-prettier": "^4.0.0",
    "mocha": "^11.2.2",
    "nock": "14.0.0-beta.7",
    "nyc": "^17.1.0",
    "prettier": "^2.8.0",
    "proxyquire": "^2.1.3",
    "sinon": "^20.0.0",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  },
  "dependencies": {
    "debug": "^4.4.0",
    "graphql": "^16.11.0",
    "graphql-request": "^6.1.0",
    "memory-cache": "^0.2.0",
    "url-parse": "^1.5.10"
  },
  "description": "",
  "types": "types/index.d.ts",
  "gitHead": "2f4820efddf4454eeee58ed1b2cc251969efdf5b",
  "files": [
    "dist",
    "types",
    "/*.d.ts"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./types/index.d.ts"
    },
    "./tools": {
      "import": "./dist/esm/tools/index.js",
      "require": "./dist/cjs/tools/index.js",
      "types": "./types/tools/index.d.ts"
    },
    "./node-tools": {
      "import": "./dist/esm/tools/index-node.js",
      "require": "./dist/cjs/tools/index-node.js",
      "types": "./types/tools/index-node.d.ts"
    }
  }
}
