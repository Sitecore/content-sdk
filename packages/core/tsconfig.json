{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "skipLibCheck": true,
    "useUnknownInCatchVariables": false,
    "outDir": "dist",
    "typeRoots": ["node_modules/@types"],
    "declarationDir": "./types",
  },
  "exclude": [
    "node_modules",
    "types",
    "dist",
    "config.d.ts",
    "editing.d.ts",
    "layout.d.ts",
    "media.d.ts",
    "utils.d.ts",
    "client.d.ts",
    "i18n.d.ts",
    "site.d.ts",
    "tools.d.ts",
    "personalize.d.ts",
    "feaas.d.ts",
    "config-cli.d.ts",
    "src/**/*.test.ts",
    "src/test-data/*",
    "src/test-setup.ts",
    "src/tools/templating/test-data/*",
  ]
}
