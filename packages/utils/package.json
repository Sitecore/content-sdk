{
  "name": "@sitecore-content-sdk/utils",
  "version": "0.1.0",
  "description": "> TODO: description",
  "author": {
    "name": "Sitecore Corporation",
    "url": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html"
  },
  "homepage": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html",
  "license": "Apache-2.0",
  "main": "dist/cjs/src/index.js",
  "module": "dist/esm/src/index.js",
  "files": [
    "dist",
    "types",
    "/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig-esm.json",
    "clean": "del-cli dist types",
    "lint": "eslint \"./src/**/*.ts\"",
    "test": "jest --config jest.config.ts",
    "prepublishOnly": "npm run build",
    "coverage": "jest --config jest.config.ts --coverage"
  },
  "bugs": {
    "url": "https://github.com/Sitecore/content-sdk/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js",
      "types": "./types/src/index.d.ts"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@jest/types": "^30.2.0",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@types/debug": "^4.1.12",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "babel-jest": "^30.2.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "52.0.3",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2"
  }
}
