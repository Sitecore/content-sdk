{
  "private": true,
  "scripts": {
    "reset": "lerna clean --yes && yarn dlx rimraf node_modules && yarn install && yarn build",
    "build": "lerna run build",
    "lint-packages": "lerna run lint",
    "scaffold-samples": "node ./scripts/scaffold-samples.js",
    "lint-samples": "node ./scripts/lint-samples.js",
    "coverage-packages": "lerna run coverage",
    "test-packages": "lerna run test",
    "install-git-hooks": "node ./scripts/install-hooks.js",
    "generate-docs": "lerna run generate-docs",
    "api-extractor": "lerna run api-extractor",
    "api-extractor:verify": "lerna run api-extractor:verify",
    "version": "yarn install && git stage yarn.lock",
    "changeset:add": "changeset add && yarn csdk:split-changesets",
    "changeset:cascade-version": "tsx ./scripts/changesets/cascade-version.ts",
    "changeset:cascade-snapshot-version": "tsx ./scripts/changesets/cascade-version.ts --snapshot",
    "changeset:publish": "changeset publish",
    "csdk:prep-release": "yarn changeset:cascade-version && yarn install",
    "csdk:release-versions-guard": "tsx ./scripts/release/guards/release-versions-guard.ts",
    "csdk:legacy-changesets-guard": "tsx ./scripts/release/guards/legacy-changesets-guard.ts",
    "csdk:refresh-legacy-deps": "tsx ./scripts/release/legacy/refresh-legacy-deps.ts",
    "csdk:prep-limited-release": "tsx ./scripts/release/prep-limited-release.ts",
    "csdk:split-changesets": "tsx ./scripts/changesets/split-changesets.ts",
    "csdk:release-line": "tsx ./scripts/release/release-line.ts",
    "csdk:post-release-sync": "tsx ./scripts/release/post-release-sync.ts",
    "changeset:test": "vitest run --config ./scripts/changesets/vitest.config.ts"
  },
  "author": {
    "name": "Sitecore Corporation",
    "url": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html"
  },
  "license": "Apache-2.0",
  "homepage": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html",
  "bugs": {
    "url": "https://github.com/sitecore/content-sdk/issues"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@microsoft/api-extractor": "^7.55.0",
    "@rushstack/eslint-patch": "^1.10.3",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@types/semver": "^7.7.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.2.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "52.0.3",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "lerna": "^9.0.3",
    "prettier": "^2.8.0",
    "semver": "^7.8.4",
    "tsx": "^4.19.4",
    "typedoc": "^0.28.4",
    "typedoc-plugin-markdown": "^4.6.3",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "packages/*",
    "templates/*",
    "samples/*"
  ],
  "resolutions": {
    "eslint-plugin-react-hooks": "^5.2.0",
    "@rushstack/eslint-patch": "1.12.0"
  },
  "packageManager": "yarn@4.12.0"
}
