{
  "private": true,
  "scripts": {
    "reset": "lerna clean --yes && yarn dlx rimraf node_modules && yarn install && yarn build",
    "build": "lerna run build",
    "lint-packages": "lerna run lint",
    "scaffold-samples": "node ./scripts/scaffold-samples.js",
    "lint-samples": "node ./scripts/lint-samples.js",
    "coverage-packages": "lerna run coverage",
    "test-packages": "lerna run test",
    "install-git-hooks": "node ./scripts/install-hooks.js",
    "generate-docs": "lerna run generate-docs",
    "api-extractor": "lerna run api-extractor",
    "api-extractor:verify": "lerna run api-extractor:verify",
    "version": "yarn install && git stage yarn.lock",
    "changeset:add": "changeset add",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "checkchange": "beachball check",
    "change": "beachball change --no-commit",
    "bump": "beachball bump --keep-change-files",
    "release": "beachball publish"
  },
  "author": {
    "name": "Sitecore Corporation",
    "url": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html"
  },
  "license": "Apache-2.0",
  "homepage": "https://doc.sitecore.com/xmc/en/developers/content-sdk/index.html",
  "bugs": {
    "url": "https://github.com/sitecore/content-sdk/issues"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@lerna-lite/cli": "^4.10.2",
    "@lerna-lite/publish": "^4.10.2",
    "@lerna-lite/run": "^4.10.2",
    "@lerna-lite/version": "^4.10.2",
    "@microsoft/api-extractor": "^7.55.0",
    "@rushstack/eslint-patch": "^1.10.3",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "beachball": "2.60.1",
    "eslint": "^9.32.0",
    "eslint-config-next": "15.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "52.0.3",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^2.8.0",
    "typedoc": "^0.28.4",
    "typedoc-plugin-markdown": "^4.6.3",
    "typescript": "~5.8.3"
  },
  "workspaces": [
    "packages/*",
    "samples/*"
  ],
  "resolutions": {
    "eslint-plugin-react-hooks": "^5.2.0",
    "@rushstack/eslint-patch": "1.12.0"
  },
  "packageManager": "yarn@3.1.0"
}
