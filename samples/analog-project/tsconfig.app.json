{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": ["node"]
  },
  "files": ["src/main.ts", "src/main.server.ts"],
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/app/pages/**/*.page.ts",
    "src/server/middleware/**/*.ts"
  ],
  "exclude": ["src/**/*.spec.ts"]
}
