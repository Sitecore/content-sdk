---
/**
 * Promo component with Default and WithText variants.
 * Default: Renders a promo image, rich text, and a link.
 * WithText: Renders a promo image with two rich text fields.
 */
import type { ComponentRendering, Field } from '@sitecore-content-sdk/astro';
import ImageField from '@sitecore-content-sdk/astro/components/Image.astro';
import RichTextField from '@sitecore-content-sdk/astro/components/RichText.astro';
import Link from '@sitecore-content-sdk/astro/components/Link.astro';

interface Props {
  fields: {
    PromoIcon?: {
      value?: Record<string, unknown>;
      metadata?: {
        [key: string]: unknown;
      };
    };
    PromoText?: Field<string>;
    PromoLink?: {
      value: { href?: string; [key: string]: unknown };
      metadata?: { [key: string]: unknown };
    };
    PromoText2?: Field<string>;
  };
  params: Record<string, string>;
  rendering: ComponentRendering;
}

const { fields, params } = Astro.props;
const { styles, RenderingIdentifier: id } = params;

const isWithTextVariant = params.FieldNames === 'WithText';
---

<div class={`component promo ${styles}`} id={id}>
  <div class="component-content">
    {
      !fields ? (
        <span class="is-empty-hint">Promo</span>
      ) : (
        <>
          <div class="field-promoicon">
            <ImageField field={fields.PromoIcon} />
          </div>
          <div class="promo-text">
            {isWithTextVariant ? (
              <>
                <div class="field-promotext">
                  <RichTextField class="promo-text" field={fields.PromoText} />
                </div>
                <div class="field-promotext">
                  <RichTextField class="promo-text" field={fields.PromoText2} />
                </div>
              </>
            ) : (
              <>
                <div class="field-promotext">
                  <RichTextField field={fields.PromoText} />
                </div>
                <div class="field-promolink">
                  <Link field={fields.PromoLink} />
                </div>
              </>
            )}
          </div>
        </>
      )
    }
  </div>
</div>
