---
import type { Page } from '@sitecore-content-sdk/atro';
import {
  QUERY_PARAM_EDITING_SECRET,
  EDITING_ALLOWED_ORIGINS,
  getEnforcedCorsHeaders,
  isEditingMode,
  isDesignLibraryRequest,
  parseEditingPreviewData,
  parseDesignLibraryPreviewData,
} from '@sitecore-content-sdk/atro';
import type { EditingQueryParams } from '@sitecore-content-sdk/atro';
import Layout from '../../../layouts/Layout.astro';
import { client } from '../../../lib/sitecore-client';
import scConfig from '../../../sitecore.config';

// This endpoint must be server-rendered (not prerendered at build time)
export const prerender = false;

const request = Astro.request;
const url = new URL(request.url);

// Parse all query parameters into a flat record
const query: EditingQueryParams = Object.fromEntries(url.searchParams.entries());

// --- CORS validation ---
const corsHeaders = getEnforcedCorsHeaders({
  requestMethod: request.method,
  headers: request.headers,
  allowedOrigins: EDITING_ALLOWED_ORIGINS,
});

if (!corsHeaders) {
  return new Response(JSON.stringify({ message: 'Invalid origin' }), {
    status: 401,
    headers: { 'Content-Type': 'application/json' },
  });
}

const responseHeaders = new Headers(corsHeaders as Record<string, string>);
responseHeaders.set('Content-Type', 'text/html');

// --- Handle CORS preflight ---
if (request.method === 'OPTIONS') {
  return new Response(null, { status: 204, headers: responseHeaders });
}

// --- Validate editing mode parameters ---
if (!isEditingMode(query)) {
  return new Response(JSON.stringify({ message: 'Missing required editing parameters' }), {
    status: 400,
    headers: responseHeaders,
  });
}

// --- Validate editing secret ---
const secret = url.searchParams.get(QUERY_PARAM_EDITING_SECRET);
if (secret !== scConfig.editingSecret) {
  return new Response(JSON.stringify({ message: 'Missing or invalid editing secret' }), {
    status: 401,
    headers: responseHeaders,
  });
}

// --- Fetch page data ---
let page: Page | null = null;

try {
  if (isDesignLibraryRequest(query.mode)) {
    page = await client.getDesignLibraryData(parseDesignLibraryPreviewData(query));
  } else {
    page = await client.getPreview(parseEditingPreviewData(query));
  }
} catch (error) {
  console.error('Error fetching editing page data:', error);
  return new Response(JSON.stringify({ message: 'Failed to fetch page data' }), {
    status: 500,
    headers: responseHeaders,
  });
}

if (!page) {
  return new Response(JSON.stringify({ message: 'Page not found' }), {
    status: 404,
    headers: responseHeaders,
  });
}
---

<Layout page={page} />
