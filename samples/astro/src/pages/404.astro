---
import type { Page } from '@sitecore-content-sdk/astro';
import { ErrorPage } from '@sitecore-content-sdk/astro';
import Layout from '../layouts/Layout.astro';
import { client } from '../lib/sitecore-client';

let page: Page | null = null;

try {
  page = await client.getErrorPage(ErrorPage.NotFound, {
    site: 'site1',
    locale: 'en',
  });
} catch (error) {
  console.error('Error occurred while fetching 404 error page:', error);
}
---

{page ? (
  <Layout page={page} />
) : (
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width" />
      <link rel="icon" href="/favicon.ico" />
      <title>Page Not Found</title>
    </head>
    <body>
      <main>
        <h1>Page Not Found</h1>
        <p>The page you are looking for does not exist.</p>
        <a href="/">Go back home</a>
      </main>
    </body>
  </html>
)}
