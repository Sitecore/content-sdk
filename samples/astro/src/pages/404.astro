---
import type { Page } from '@sitecore-content-sdk/atro';
import { ErrorPage } from '@sitecore-content-sdk/atro';
import Layout from '../layouts/Layout.astro';
import { client } from '../lib/sitecore-client';

let page: Page | null = null;

try {
  page = await client.getErrorPage(ErrorPage.NotFound, {
    site: 'site1',
    locale: 'en',
  });
} catch (error) {
  console.error('Error occurred while fetching 404 error page:', error);
}

const route = page?.layout.sitecore.route;
const title = (route?.fields?.Title as { value?: string })?.value ?? 'Page Not Found';
---

<Layout>
  <title>{title}</title>
  <main>
    {page && route ? (
      <div>
        <h1>{title}</h1>
        <pre>{JSON.stringify(route.fields, null, 2)}</pre>
      </div>
    ) : (
      <div>
        <h1>Page Not Found</h1>
        <p>The page you are looking for does not exist.</p>
        <a href="/">Go back home</a>
      </div>
    )}
  </main>
</Layout>
