---
import type { GetStaticPaths } from 'astro';
import type { Page, StaticPath } from '@sitecore-content-sdk/astro';
import Layout from '../layouts/Layout.astro';
import { client } from '../lib/sitecore-client';
import config from '../sitecore.config';
import { normalizeSiteRewrite } from '@sitecore-content-sdk/astro';
import { i18n } from 'astro:config/server';

export const getStaticPaths = (async () => {
  const sites = [config.defaultSite];
  const languages = (i18n?.locales as string[]) || [config.defaultLanguage];

  let staticPaths: StaticPath[] = [];

  try {
    staticPaths = await client.getPagePaths(sites, languages);
  } catch (error) {
    console.error('Error occurred while fetching static paths:', error);
  }

  return staticPaths.map((staticPath) => ({
    params: {
      // Astro catch-all: undefined = root "/", string = everything else
      path:
        staticPath.params.path.length > 0
          ? normalizeSiteRewrite(staticPath.params.path.join('/'))
          : undefined,
    },
    props: {
      locale: staticPath.locale ?? config.defaultLanguage,
    }
  }));
}) satisfies GetStaticPaths;

// Resolve the path from params and fetch the page
const { path } = Astro.params;
const { locale } = Astro.props;
const pagePath = path ? `/${path}` : '/';

let page: Page | null = null;

try {
  console.log('Fetching page data for', pagePath, { locale, site: config.defaultSite });
  page = await client.getPage(pagePath, {
    locale,
    site: config.defaultSite,
  });
} catch (error) {
  console.error(`Error fetching page data for ${pagePath}:`, error);
}

if (!page) {
  return Astro.rewrite('/404');
}
---

<Layout page={page} />
